__pycache__/
*.py[cod]
.venv/
vendor/
logs/
outputs/

# Dados: SÓ data/publico/ vai para o GitHub, com os apps mascarados (APP_xxx) e os nomes de
# pessoas censurados. data/brasil/ e data/mercados_internacionais/ são as pastas de trabalho:
# têm nome, ID e descrição dos apps, e as reviews brutas (texto sem censura, data com hora).
# A chave APP_xxx -> app real fica em data/chave_apps_mascarados_NAO_COMPARTILHAR/.
data/*
!data/publico/
